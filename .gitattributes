# Marquer les notebooks Jupyter comme générés pour ne pas fausser les statistiques de langages
notebooks/** linguist-generated=true
*.ipynb linguist-generated=true

# Exclure les fichiers de données et ressources des statistiques
*.csv linguist-generated=true
*.json linguist-documentation=false
*.jpg linguist-generated=true
*.jpeg linguist-generated=true
*.png linguist-generated=true
*.svg linguist-generated=true
*.gif linguist-generated=true

# Marquer les fichiers de configuration comme documentation
*.toml linguist-documentation
*.txt linguist-documentation

# S'assurer que Python est correctement détecté
*.py linguist-language=Python
